# The secrets Crossfade needs, names only (architecture §6). Never put a value in this file.
# Nothing reads these yet: they arrive with the create-link Edge Function. Each one is set with
#   supabase secrets set NAME=value
# or, to run the function locally, in a .env file next to this one (.gitignore blocks .env).

# Step 1 of create-link: the sender's passcode, compared in constant time.
SENDER_PASSCODE=

# No Apple keys: create-link reads the public share page instead of the Apple Music API (ADR 0012).

# Crossfade's own Premium Spotify account (ADR 0006). The refresh token is fetched once, by hand.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Not listed: the Supabase secret key (Edge Functions get it automatically) and the
# publishable key, which is public by design and lives in src/config.js.
